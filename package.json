{
  "name": "supple-css",
  "description": "Reliable and testable CSS framework. Fluid, Variable, supple if you will",
  "repository": "https://codeberg.org/Supple-kit/css.git",
  "author": "Bram Smulders <source@supple.build>",
  "funding": [
    {
      "type": "github",
      "url": "https://www.github.com/sponsors/bramsmulders"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.me/smuldersbram/EUR"
    }
  ],
  "license": "MIT",
  "keywords": [
    "supple",
    "supple-kit",
    "css",
    "scss",
    "itcss",
    "grid",
    "framework",
    "bem",
    "tailwind"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "pnpm run \"/^dev:.*/\"",
    "dev:css": "pnpm run --filter=@supple-kit/css dev",
    "dev:docs": "pnpm run --filter=docs dev",
    "prettier": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "@antfu/eslint-config": "^4.11.0",
    "eslint": "^9.23.0",
    "eslint-plugin-format": "^1.0.1",
    "prettier-plugin-astro": "^0.14.1",
    "eslint-plugin-astro": "^1.3.1",
    "astro-eslint-parser": "^1.2.2"
  }
}
