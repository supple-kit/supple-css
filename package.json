{
	"name": "supple-css",
	"description": "Reliable and testable CSS framework. Fluid, Variable, supple if you will",
	"author": "Bram Smulders <source@supple.build>",
	"license": "MIT",
	"funding": [
		{
			"type": "github",
			"url": "https://www.github.com/sponsors/bramsmulders"
		},
		{
			"type": "paypal",
			"url": "https://www.paypal.me/smuldersbram/EUR"
		}
	],
	"repository": "https://codeberg.org/Supple-kit/css.git",
	"keywords": [
		"supple",
		"supple-kit",
		"css",
		"scss",
		"itcss",
		"grid",
		"framework",
		"bem",
		"tailwind"
	],
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "pnpm run \"/^dev:.*/\"",
		"css:dev": "pnpm run --filter=@supple-kit/css dev",
		"css:build": "pnpm run --filter=@supple-kit/css build",
		"docs:dev": "pnpm run --filter=docs dev",
		"docs:build": "pnpm run --filter=docs build",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"prepare": "husky"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^4.11.0",
		"astro-eslint-parser": "^1.2.2",
		"eslint": "^9.23.0",
		"eslint-plugin-astro": "^1.3.1",
		"eslint-plugin-format": "^1.0.1",
		"husky": "^9.1.7",
		"prettier": "^3.5.3",
		"prettier-plugin-astro": "^0.14.1"
	}
}
