{
	"name": "supple-css",
	"description": "Reliable and testable CSS framework. Fluid, Variable, supple if you will",
	"repository": "https://github.com/supple-kit/supple-css.git",
	"author": "Bram Smulders <source@bram.is>",
	"funding": [
		{
			"type": "github",
			"url": "https://www.github.com/sponsors/bramsmulders"
		},
		{
			"type": "paypal",
			"url": "https://www.paypal.me/smuldersbram/EUR"
		}
	],
	"license": "MIT",
	"keywords": [
		"supple",
		"supple-kit",
		"css",
		"scss",
		"itcss",
		"grid",
		"framework",
		"bem",
		"tailwind"
	],
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "pnpm run \"/^dev:.*/\"",
		"dev:css": "pnpm run --filter=@supple-kit/css dev",
		"dev:docs": "pnpm run --filter=docs dev",
		"prettier": "prettier --write ."
	},
	"devDependencies": {
		"prettier": "^3.5.3"
	}
}
